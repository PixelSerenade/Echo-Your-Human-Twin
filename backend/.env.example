# Gemini API Key (Backend only - never expose to frontend)
GEMINI_API_KEY=

# PostgreSQL connection (URL-encode special characters in the password, e.g. @ as %40)
DATABASE_URL=postgresql+asyncpg://YOUR_USER:YOUR_PASSWORD@localhost:5432/humantwin

# Server Configuration
HOST=0.0.0.0
PORT=8003
DEMO_MODE=true

# Web Push (generate one VAPID P-256 key pair per environment; keep private key secret)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PATH=data/vapid_private.pem
VAPID_SUBJECT=mailto:admin@example.com
